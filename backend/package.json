{
  "name": "pay-domovina-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply pay_domovina --local",
    "db:migrate:prod": "wrangler d1 migrations apply pay_domovina --remote",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/receipts/client && tsc --noEmit -p src/setup/client",
    "test": "vitest run",
    "build:receipt-client": "node scripts/build-receipt-client.mjs",
    "build:setup-client": "node scripts/build-setup-client.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "bwip-js": "^4.11.4",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "qrcode-generator": "^2.0.4",
    "viem": "^2.50.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "wrangler": "^3.99.0"
  }
}
