{
  "name": "wallet-domovina-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler pages deploy dist --project-name=${BRAND_PROJECT:-wallet-domovina} --commit-message=\"deploy from main\"",
    "build:default": "VITE_BRAND=default npm run build",
    "build:sportklub": "VITE_BRAND=sportklub npm run build",
    "build:zupa": "VITE_BRAND=zupa npm run build",
    "deploy:default": "BRAND_PROJECT=wallet-domovina npm run deploy",
    "deploy:sportklub": "BRAND_PROJECT=wallet-sportklub npm run deploy",
    "deploy:zupa": "BRAND_PROJECT=wallet-zupa npm run deploy",
    "deploy:staging": "wrangler pages deploy dist --project-name=wallet-staging --branch main --commit-dirty=true --commit-message=\"staging\"",
    "ship:default": "npm run build:default && npm run deploy:default",
    "ship:sportklub": "npm run build:sportklub && npm run deploy:sportklub",
    "ship:zupa": "npm run build:zupa && npm run deploy:zupa",
    "ship:staging": "npm run build:default && npm run deploy:staging",
    "ship:all": "npm run ship:default && npm run ship:sportklub && npm run ship:zupa"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@safe-global/protocol-kit": "^7.1.0",
    "@safe-global/safe-passkey": "0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "qr-code-styling": "^1.9.2",
    "qr-scanner": "^1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.50.0",
    "wouter": "^3.10.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251101.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "~3.4.18",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.93.0"
  }
}
