# Claude Code local state
.claude/

# Wrangler local state (Cloudflare Worker dev)
.wrangler/

# Node artifacts must live under backend/, never at repo root.
# These guards stop accidental `npm install` runs from the wrong cwd
# leaking dependencies into the Flutter project root.
/node_modules/
/package.json
/package-lock.json

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# firecrawl scratch output
.firecrawl/

# GP spike local state (throwaway keys + JWTs)
scripts/.gp-spike-state.json
